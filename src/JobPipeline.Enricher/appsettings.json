{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Enrich": {
    "DataDir": "C:\\JobPipeline\\data",
    "PollSeconds": 30,
    "MaxAttempts": 3,
    "RetryDelayMinutes": 15,
    "StaleClaimMinutes": 15,
    "RequestDelayMs": 2000,
    "RequestTimeoutSeconds": 30,
    "SkipHosts": [ "linkedin.com", "indeed.com", "glassdoor.com", "ziprecruiter.com" ]
  }
}
